# URI del Clúster de la Nube (Con appName integrado)
MONGO_URI=mongodb+srv://bd_realestate:abc123456@c-realestate.xyfip8o.mongodb.net/?appName=C-RealEstate

# Nombre exacto de la Base de Datos obtenido de la interfaz visual
MONGO_DB_NAME=BD_RealEstate

# Colección de Entrada: Contiene los datos crudos extraídos por el grupo
MONGO_COLLECTION_RAW=Propiedades

# Colección de Salida: Destino de tus análisis de correlación y datos sin outliers
MONGO_COLLECTION_PROCESSED=Propiedades_Procesadas